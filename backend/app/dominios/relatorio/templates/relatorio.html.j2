<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Relatório estatístico · {{ c.nome_arquivo }}</title>
  <style>
{% include "estilos.css" %}
  </style>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16/dist/katex.min.css">
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16/dist/katex.min.js"></script>
  {{ c.script_plotly | safe }}
</head>
<body>
  <header class="cabecalho">
    <div class="marca"><span>Analisador e Gerador de Dados</span><span>{{ c.gerado_em }}</span></div>
    <h1>Relatório estatístico</h1>
    <p class="subtitulo">{{ c.subtitulo }}</p>
  </header>
  {% set numero = namespace(secao=0, figura=0) %}

  {% if c.leitura is not none %}
  {% set numero.secao = numero.secao + 1 %}
  <section>
    <h2>{{ numero.secao }}. {{ titulos.leitura }}</h2>
    <p>{{ c.leitura }}</p>
  </section>
  {% endif %}

  {% if c.tipos is not none %}
  {% set numero.secao = numero.secao + 1 %}
  <section>
    <h2>{{ numero.secao }}. {{ titulos.tipos }}</h2>
    <table>
      <thead><tr><th scope="col">Coluna</th><th scope="col">Tipo</th><th scope="col">Motivo</th></tr></thead>
      <tbody>
      {% for t in c.tipos %}
        <tr><td class="mono">{{ t.coluna }}</td><td>{{ t.tipo }}</td><td>{{ t.motivo }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if c.limpeza is not none %}
  {% set numero.secao = numero.secao + 1 %}
  <section>
    <h2>{{ numero.secao }}. {{ titulos.limpeza }}</h2>
    <p>{{ c.limpeza | join(" ") }}</p>
  </section>
  {% endif %}

  {% macro figura(f) %}
    {% set numero.figura = numero.figura + 1 %}
    <figure>
      <figcaption>Figura {{ numero.figura }} · {{ f.titulo }}</figcaption>
      {{ f.html | safe }}
      <p class="nota">{{ f.resumo }}</p>
    </figure>
  {% endmacro %}
  {% macro medidas(itens) %}
    <dl class="medidas">
      {% for m in itens %}<div><dt>{{ m.rotulo }}</dt><dd class="mono">{{ m.valor }}</dd>{% if m.nota %}<dd class="selo">{{ m.nota }}</dd>{% endif %}</div>{% endfor %}
    </dl>
  {% endmacro %}
  {% macro tabela(cabecalho, linhas, classe) %}
    <table class="{{ classe }}">
      <thead><tr>{% for titulo in cabecalho %}<th scope="col">{{ titulo }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for linha in linhas %}
        <tr>{% for celula in linha %}<td{% if not loop.first %} class="numero"{% endif %}>{{ celula }}</td>{% endfor %}</tr>
      {% endfor %}
      </tbody>
    </table>
  {% endmacro %}
  {% macro aviso(a) %}
    <article class="aviso sev-{{ a.severidade }}">
      <div class="aviso-texto">
        <p class="selo-severidade">{{ a.selo }}</p>
        <h3>{{ a.titulo }}</h3>
        <p>{{ a.resumo }}</p>
        <div class="partes">
          <div><h4>Por que chama atenção</h4><p>{{ a.por_que }}</p></div>
          <div><h4>Pode ser normal se…</h4><p>{{ a.pode_ser_normal }}</p></div>
        </div>
        {% if a.exemplo %}<p class="exemplo"><span class="rotulo">Exemplo</span> <span class="mono">{{ a.exemplo }}</span></p>{% endif %}
        <p><strong>O que fazer:</strong> {{ a.o_que_fazer }}</p>
        <h4>Detalhes técnicos</h4>
        <dl class="detalhes">
          {% for d in a.detalhes %}<dt>{{ d.rotulo }}</dt><dd>{{ d.valor }}{% if d.nota %} <span class="nota">· {{ d.nota }}</span>{% endif %}</dd>{% endfor %}
        </dl>
      </div>
      {% if a.figura %}{{ figura(a.figura) }}{% endif %}
    </article>
  {% endmacro %}

  {% for col in c.colunas or [] %}
  {% set numero.secao = numero.secao + 1 %}
  <section class="coluna">
    <h2>{{ numero.secao }}. Análise de <span class="mono">{{ col.coluna }}</span></h2>
    <p class="nota">{{ col.tipo }} · {{ col.n }} valores válidos{% if col.n_faltantes %} · {{ col.n_faltantes }} faltantes{% endif %}</p>
    {% set a = col.analises %}
    {% if a %}
    {% if a.medidas %}{{ medidas(a.medidas) }}{% endif %}
    {% if a.separatrizes %}<p class="mono">{{ a.separatrizes }}</p>{% endif %}
    {{ tabela(a.cabecalho_tabela, a.linhas_tabela, "frequencias") }}
    {% if a.figura %}{{ figura(a.figura) }}{% endif %}
    {% for frase in a.interpretacoes %}<p>{{ frase }}</p>{% endfor %}
    {% endif %}
    {% set f = col.forma %}
    {% if f %}
    <h3>Forma e distribuição</h3>
    {% if f.motivo %}<p>{{ f.motivo }}</p>{% endif %}
    {% if f.medidas %}{{ medidas(f.medidas) }}{% endif %}
    {% for frase in f.ajustes %}<p>{{ frase }}</p>{% endfor %}
    {% if f.interpretacao %}<p>{{ f.interpretacao }}</p>{% endif %}
    {% if f.figura %}{{ figura(f.figura) }}{% endif %}
    {% endif %}
  </section>
  {% endfor %}

  {% set b = c.bivariada %}
  {% if b is not none %}
  {% set numero.secao = numero.secao + 1 %}
  <section class="bivariada">
    <h2>{{ numero.secao }}. {{ titulos.bivariada }}</h2>
    {# A legenda do heatmap já traz o resumo da matriz. #}
    {% if b.matriz %}{{ figura(b.matriz) }}{% else %}<p>{{ b.resumo }}</p>{% endif %}
    {% if b.vazio %}<p>{{ b.vazio }}</p>{% endif %}
    {% for par in b.pares %}
    <h3><span class="mono">{{ par.y }}</span> em função de <span class="mono">{{ par.x }}</span></h3>
    {{ medidas(par.medidas) }}
    <p class="mono">{{ par.equacao }}</p>
    {% for frase in par.interpretacoes %}<p>{{ frase }}</p>{% endfor %}
    {% if par.figura %}{{ figura(par.figura) }}{% endif %}
    {% endfor %}
  </section>
  {% endif %}

  {% set g = c.gerador %}
  {% if g is not none %}
  {% set numero.secao = numero.secao + 1 %}
  <section class="gerador">
    <h2>{{ numero.secao }}. {{ titulos.gerador }}</h2>
    <p class="nota">{{ g.subtitulo }}</p>
    <dl class="parametros">
      {% for p in g.parametros %}<div><dt>{{ p.rotulo }}</dt><dd>{{ p.valor }}</dd></div>{% endfor %}
      <div><dt>Método</dt><dd>{{ g.metodo }}</dd></div>
    </dl>
    <h3>Como geramos</h3>
    <p>{{ g.explicacao }}</p>
    <h3>Original × Gerado</h3>
    {{ tabela(g.cabecalho_comparacao, g.linhas_comparacao, "comparacao") }}
    {% if g.figura %}{{ figura(g.figura) }}{% endif %}
  </section>
  {% endif %}

  {% set d = c.detector %}
  {% if d is not none %}
  {% set numero.secao = numero.secao + 1 %}
  <section class="detector">
    <h2>{{ numero.secao }}. {{ titulos.detector }}</h2>
    <p class="frase-resumo">{{ d.frase }}</p>
    <p class="nota">{{ d.detalhe }}</p>
    {% if d.vazio %}<p>{{ d.vazio }}</p>{% else %}<p class="contadores">{{ d.contadores }}</p>{% endif %}
    {% for a in d.avisos %}{{ aviso(a) }}{% endfor %}
    {% if d.nao_verificadas %}
    <h3>Regras não verificadas</h3>
    <ul class="nao-verificadas">
      {% for frase in d.nao_verificadas %}<li>{{ frase }}</li>{% endfor %}
    </ul>
    {% endif %}
  </section>
  {% endif %}

  {% set ap = c.formulas %}
  {% if ap is not none %}
  {% set numero.secao = numero.secao + 1 %}
  <section class="apendice">
    <h2>{{ numero.secao }}. {{ titulos.formulas }}</h2>
    {% for g in ap.grupos %}
    <h3>{{ g.titulo }}</h3>
    <ul class="formulas">
      {% for x in g.formulas %}<li><span class="nome-formula">{{ x.nome }}</span>: {% if x.latex %}<span class="formula" data-latex="{{ x.latex }}">{{ x.texto }}</span>{% else %}<span class="formula-texto">{{ x.texto }}</span>{% endif %}{% if x.onde %} <span class="nota">· {{ x.onde }}</span>{% endif %}</li>{% endfor %}
    </ul>
    {% endfor %}
  </section>
  {% endif %}

  <footer class="rodape">Disciplina de Estatística · gerado pelo Analisador e Gerador de Dados</footer>
  <script>
    window.addEventListener("load", function () {
      if (!window.katex) return;
      document.querySelectorAll(".formula[data-latex]").forEach(function (el) {
        try { window.katex.render(el.dataset.latex, el, { throwOnError: false }); } catch (e) { /* mantém o texto */ }
      });
    });
  </script>
</body>
</html>
